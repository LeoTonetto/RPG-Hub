# Copie para `.env` e ajuste o que precisar:
#     cp .env.exemplo .env
#
# Só o docker-compose.yml lê este arquivo.

# Porta EXTERNA, pela qual o app acessa o servidor.
# Mude se a 3001 já estiver ocupada na VPS — o container nem inicia nesse caso.
# Descubra quem está usando:  ./deploy/diagnostico.sh
HOST_PORT=3001

# Teto de cada arquivo de cena, em MB
# SCENE_MAX_MB=150

# Quantas cenas guardar antes de podar as antigas
# SCENE_KEEP=30

# Minutos que a sala espera vazia antes de fechar. Ao fechar, as cenas que ela
# enviou sao apagadas do disco.
# ROOM_EMPTY_MINUTES=10

# Teto absoluto de uma sala, mesmo com gente conectada
# ROOM_MAX_HOURS=24
